DATABASE_URL="file:./dev.db"

# Base URL used to build zbackroom login/signup redirect URIs.
APP_URL="http://localhost:3003"

# Login/signup/password reset are owned by zbackroom.com — FamilyCall only
# verifies the shared session cookie against zbackroom's internal API.
# ZBACKROOM_URL is where users get redirected to sign in. INTERNAL_API_SECRET
# must be the exact same value as zbackroom's INTERNAL_API_SECRET (generate
# once with `openssl rand -hex 32`, set it in both apps' env).
ZBACKROOM_URL="https://zbackroom.com"
INTERNAL_API_SECRET=""

# Admin dashboard lives at zbackroom.com now, not here — see its
# .env.example for ADMIN_EMAILS. This app just exposes
# /api/internal/admin-data (bearer-auth via INTERNAL_API_SECRET above) for
# zbackroom's /admin to read.

# Public URL of the call server (the separate stt_videocall deployment —
# WebRTC signaling, mic capture, live captions, coturn TURN relay, on its
# own VPS). Used only to build the shareable call links shown on
# /rooms/[id] — the call server's own URL query-param contract
# (room/name/lang/ui/simple/font) is unchanged.
CALL_SERVER_URL="https://call.zbackroom.com"

# Checked against the Authorization: Bearer header on GET
# /api/internal/validate-room and POST /api/internal/call-usage — the two
# endpoints the call server calls. Generate independently from
# INTERNAL_API_SECRET above (openssl rand -hex 32) and set the identical
# value as FAMILYCALL_INTERNAL_SECRET in the call server's own .env — see
# SPEC.md's "Call-server integration contract" for why this is a
# deliberately separate secret, not a reuse of INTERNAL_API_SECRET.
FAMILYCALL_INTERNAL_SECRET=""
