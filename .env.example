# ---- Server ----
HOST=127.0.0.1          # bind address (keep 127.0.0.1 behind Caddy; 0.0.0.0 to expose directly)
PORT=8080
LOG_LEVEL=info          # debug | info | warn | error
ROOM_KEY=               # optional shared secret; phones must open the app with ?key=<ROOM_KEY>

# ---- Speech-to-text ----
# STT_PROVIDER is auto-detected from the keys below (openai > deepgram > xfyun > mock);
# set it explicitly (openai | deepgram | xfyun | mock) to force one.
STT_PROVIDER=
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe     # gpt-live-transcribe | gpt-4o-transcribe | gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_DELAY=low                     # minimal | low | medium | high | xhigh (latency vs. accuracy)
OPENAI_NOISE_REDUCTION=near_field               # near_field | far_field | none
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# iFlytek 讯飞 实时语音转写 (RTASR, https://www.xfyun.cn/services/rtasr): strong Mandarin,
# transcribes Chinese with embedded English by default (a speaker set to en-US uses lang=en,
# which needs the multi-language option enabled on the xfyun account). Buy hours in the console.
XFYUN_APP_ID=
XFYUN_API_KEY=
# Free-text hint shown to the recognizer (names, places, vocabulary).
STT_PROMPT=A relaxed family video call between relatives, spoken in Mandarin Chinese and English.
# Close an idle recognizer session after this many ms without audio (mic muted).
STT_IDLE_CLOSE_MS=45000

# ---- WebRTC ICE ----
# Your own coturn server. TURN also answers STUN, so STUN_URLS can stay empty.
# Do NOT rely on stun.l.google.com: it is blocked in mainland China.
STUN_URLS=
TURN_URLS=turn:call.example.com:3478?transport=udp,turn:call.example.com:3478?transport=tcp,turns:call.example.com:5349?transport=tcp
# Either a shared secret (coturn `use-auth-secret`, recommended: credentials expire) ...
TURN_SECRET=change-me-to-a-long-random-string
TURN_TTL=43200
# ... or a static user (coturn `lt-cred-mech` + `user=`)
TURN_USER=
TURN_PASS=
